---
/**
 * Hand-drawn Art Nouveau ornament sprite (original SVG, no clipart).
 * Every shape is ANCHORED: (0,0) is the base / centre, and it grows toward -y, so the vine script can place it.
 * Colours come from CSS custom properties (set on the <svg> that <use>s them):
 *   --n-line (outline)  --n-a (foliage)  --n-b (petal)  --n-c (gilt)  --n-d (cream / glass)  --n-e (second petal)
 * The .n-* classes live in theme.css and reach into <use> trees because the sprite is in the same document.
 */
// peacock-feather barbs: little curved strokes either side of a spine, longest mid-way
const barbs: string[] = [];
for (let i = 0; i < 38; i++) {
  const t = i / 37;
  const y = -20 - t * 150;
  const len = 5 + 25 * Math.sin(Math.PI * (0.06 + 0.9 * t));
  const rise = 9 + 5 * (1 - t);
  const p = (x: number, yy: number) => `${x.toFixed(1)} ${yy.toFixed(1)}`;
  barbs.push(`M0 ${y.toFixed(1)} C ${p(-len * 0.35, y - rise * 0.15)} ${p(-len * 0.8, y - rise * 0.6)} ${p(-len, y - rise)}`);
  barbs.push(`M0 ${y.toFixed(1)} C ${p(len * 0.35, y - rise * 0.15)} ${p(len * 0.8, y - rise * 0.6)} ${p(len, y - rise)}`);
}
// fern leaflets along a curved rachis
const fern: string[] = [];
for (let i = 0; i < 9; i++) {
  const y = -14 - i * 10;
  const w = 20 - i * 1.7;
  fern.push(`M${(Math.sin(i * 0.5) * 2).toFixed(1)} ${y} C ${(-w * 0.5).toFixed(1)} ${y - 3} ${(-w * 0.9).toFixed(1)} ${y - 6} ${(-w).toFixed(1)} ${y - 12} C ${(-w * 0.4).toFixed(1)} ${y - 9} -2 ${y - 5} 0 ${y}Z`);
  fern.push(`M${(Math.sin(i * 0.5) * 2).toFixed(1)} ${y} C ${(w * 0.5).toFixed(1)} ${y - 3} ${(w * 0.9).toFixed(1)} ${y - 6} ${w.toFixed(1)} ${y - 12} C ${(w * 0.4).toFixed(1)} ${y - 9} 2 ${y - 5} 0 ${y}Z`);
}
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="n-gold" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#e6cd86" />
      <stop offset=".45" stop-color="#b8872a" />
      <stop offset="1" stop-color="#e9d391" />
    </linearGradient>

    <!-- LEAF: pointed, one side fuller, tip leaning over -->
    <g id="n-leaf">
      <path class="n-a" d="M0 0 C -21 -22 -23 -62 3 -94 C 25 -62 21 -24 0 0Z" />
      <path class="n-line n-thin" d="M0 -2 C -3 -30 1 -62 3 -90" />
      <path class="n-line n-thin" d="M-1 -20 C -8 -24 -13 -30 -15 -39 M-1 -20 C 8 -24 13 -30 14 -39 M0 -43 C -7 -48 -11 -54 -12 -62 M1 -43 C 8 -48 11 -54 11 -62 M2 -64 C -3 -68 -5 -73 -5 -78 M2 -64 C 6 -68 7 -73 7 -78" />
    </g>

    <!-- LANCE: long sword leaf (iris foliage) -->
    <g id="n-lance">
      <path class="n-a" d="M-3 0 C 0 -52 -10 -104 12 -170 C 22 -112 14 -50 5 0Z" />
      <path class="n-line n-thin" d="M1 -4 C 3 -56 -2 -104 11 -164" />
    </g>

    <!-- CURL: tendril that ends in a spiral -->
    <g id="n-curl">
      <path class="n-line n-bold" d="M0 0 C 0 -22 -3 -40 9 -52 C 22 -64 40 -53 36 -39 C 32 -28 18 -31 20 -40 C 21 -45 27 -45 28 -41" />
    </g>

    <!-- BUD with two sepals -->
    <g id="n-bud">
      <path class="n-b" d="M0 0 C -11 -10 -13 -29 0 -46 C 13 -29 11 -10 0 0Z" />
      <path class="n-line n-thin" d="M0 -4 C -3 -16 -2 -30 0 -42" />
      <path class="n-a" d="M0 0 C -14 -3 -19 -13 -17 -23 C -9 -17 -3 -10 0 0Z" />
      <path class="n-a" d="M0 0 C 14 -3 19 -13 17 -23 C 9 -17 3 -10 0 0Z" />
    </g>

    <!-- IRIS: three standards, three falls with a gilt beard, sword leaves -->
    <g id="n-iris">
      <use href="#n-lance" transform="rotate(-9) scale(.78 .6)" />
      <use href="#n-lance" transform="rotate(13) scale(-.7 .52)" />
      <path class="n-line n-bold" d="M0 0 C 5 -36 -5 -76 0 -118" />
      <!-- falls -->
      <path class="n-b" d="M-1 -116 C -14 -112 -42 -112 -62 -92 C -58 -78 -38 -78 -26 -90 C -14 -98 -5 -106 -1 -116Z" />
      <path class="n-b" d="M1 -116 C 14 -112 42 -112 62 -92 C 58 -78 38 -78 26 -90 C 14 -98 5 -106 1 -116Z" />
      <path class="n-line n-gilt" d="M-4 -112 C -18 -108 -34 -102 -50 -91 M4 -112 C 18 -108 34 -102 50 -91" />
      <!-- standards -->
      <path class="n-e" d="M-3 -118 C -26 -124 -44 -146 -41 -174 C -24 -166 -8 -146 -3 -118Z" />
      <path class="n-e" d="M3 -118 C 26 -124 44 -146 41 -174 C 24 -166 8 -146 3 -118Z" />
      <path class="n-e" d="M0 -118 C -14 -138 -15 -166 0 -190 C 15 -166 14 -138 0 -118Z" />
      <path class="n-line n-thin" d="M0 -122 C -4 -140 -4 -160 0 -182" />
      <path class="n-c" d="M0 -118 m-5 0 a5 5 0 1 0 10 0 a5 5 0 1 0 -10 0" />
    </g>

    <!-- GINKGO: fan leaf with a notch, long stalk -->
    <g id="n-ginkgo">
      <path class="n-line n-bold" d="M0 0 C 2 -12 -1 -22 0 -30" />
      <path class="n-a" d="M0 -28 C -32 -33 -46 -62 -36 -82 C -26 -75 -14 -78 -1 -90 C 14 -78 26 -75 36 -82 C 46 -62 32 -33 0 -28Z" />
      <path class="n-line n-thin" d="M0 -30 L-26 -68 M0 -30 L-14 -78 M0 -30 L0 -84 M0 -30 L14 -78 M0 -30 L26 -68" />
    </g>

    <!-- DRAGONFLY, top view, centred -->
    <g id="n-wing">
      <path class="n-d n-glass" d="M3 -18 C 20 -36 56 -42 80 -31 C 70 -17 34 -11 3 -11Z" />
      <path class="n-d n-glass" d="M3 -8 C 26 -8 58 2 72 20 C 52 29 21 14 3 -1Z" />
      <path class="n-line n-hair" d="M6 -15 C 28 -27 52 -31 76 -30 M9 -12 C 30 -18 50 -21 68 -24 M20 -22 L22 -13 M36 -27 L38 -17 M52 -30 L53 -21 M7 -5 C 30 -3 52 6 66 19 M12 -2 C 30 2 44 10 56 21 M26 3 L32 -3 M40 10 L46 5" />
      <path class="n-b" d="M72 -30 l7 1.5 l-1 3.2 l-7 -1.4Z" />
    </g>
    <g id="n-dragonfly">
      <use href="#n-wing" />
      <use href="#n-wing" transform="scale(-1 1)" />
      <path class="n-a" d="M0 -30 C 5 -30 6 -23 4 -19 L4 -8 L2.6 52 L0 66 L-2.6 52 L-4 -8 L-4 -19 C -6 -23 -5 -30 0 -30Z" />
      <circle class="n-b" cx="-3.2" cy="-27" r="3.2" />
      <circle class="n-b" cx="3.2" cy="-27" r="3.2" />
      <path class="n-line n-hair" d="M-3.6 4 H3.6 M-3.4 14 H3.4 M-3.2 24 H3.2 M-3 34 H3 M-2.8 43 H2.8" />
    </g>

    <!-- PEACOCK FEATHER with eye -->
    <g id="n-feather">
      <path class="n-line n-hair" d={barbs.join(' ')} />
      <path class="n-line n-gilt" d="M0 0 C 3 -50 -3 -100 0 -172" />
      <ellipse class="n-c" cx="0" cy="-138" rx="15" ry="22" />
      <ellipse class="n-a" cx="0" cy="-138" rx="11.5" ry="18" />
      <ellipse class="n-e" cx="0" cy="-139" rx="7.5" ry="12.5" />
      <ellipse class="n-b" cx="0" cy="-140" rx="3.6" ry="6.4" />
      <ellipse class="n-d" cx="-1.2" cy="-143" rx="1.1" ry="2" />
    </g>

    <!-- FERN SPRIG -->
    <g id="n-fern">
      <path class="n-line n-bold" d="M0 0 C 3 -26 -2 -60 3 -108" />
      <path class="n-a" d={fern.join(' ')} />
    </g>

    <!-- BERRY SPRIG: arching stem, leaf pairs, round fruits -->
    <g id="n-berry">
      <path class="n-line n-bold" d="M0 0 C 2 -40 24 -70 54 -78" />
      <use href="#n-leaf" transform="translate(6 -36) rotate(-62) scale(.42)" />
      <use href="#n-leaf" transform="translate(16 -54) rotate(52) scale(.38)" />
      <use href="#n-leaf" transform="translate(32 -68) rotate(-40) scale(.34)" />
      <path class="n-line n-thin" d="M54 -78 C 62 -78 66 -72 66 -66 M54 -78 C 58 -84 66 -84 70 -80 M54 -78 C 56 -86 62 -92 68 -92" />
      <circle class="n-b" cx="66" cy="-64" r="5.4" />
      <circle class="n-e" cx="72" cy="-80" r="5" />
      <circle class="n-b" cx="69" cy="-93" r="4.6" />
      <circle class="n-c" cx="65" cy="-66" r="1.2" />
    </g>

    <!-- CORNER spandrel: grows from the top-left corner into the frame -->
    <g id="n-corner">
      <path class="n-line n-bold" d="M4 120 C 4 66 14 26 54 14 C 80 7 102 18 97 35 C 93 48 77 48 76 37 C 75 30 82 28 85 33" />
      <path class="n-line n-bold" d="M120 4 C 66 4 26 14 14 54 C 7 80 18 102 35 97 C 48 93 48 77 37 76 C 30 75 28 82 33 85" />
      <use href="#n-leaf" transform="translate(30 30) rotate(-135) scale(.5)" />
      <use href="#n-bud" transform="translate(52 52) rotate(-135) scale(.7)" />
      <circle class="n-c" cx="6" cy="6" r="3.2" />
    </g>

    <!-- seed pod, for lists -->
    <g id="n-seed">
      <path class="n-b" d="M0 0 C -6 -5 -6 -14 0 -22 C 6 -14 6 -5 0 0Z" />
      <path class="n-line n-hair" d="M0 -2 V -19" />
    </g>
  </defs>
</svg>
