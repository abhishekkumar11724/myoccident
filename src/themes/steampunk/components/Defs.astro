---
/** Shared SVG paint servers (brass, copper, iron, verdigris, dial face, glass). Rendered once, referenced with url(#...). */
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="g-brass" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fbeab0" /><stop offset=".22" stop-color="#e3bf6b" /><stop offset=".5" stop-color="#b98a36" /><stop offset=".74" stop-color="#8a6420" /><stop offset="1" stop-color="#d9ad55" />
    </linearGradient>
    <linearGradient id="g-brass-v" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f7e2a0" /><stop offset=".3" stop-color="#d4a548" /><stop offset=".65" stop-color="#8a6420" /><stop offset="1" stop-color="#d8ae55" />
    </linearGradient>
    <linearGradient id="g-copper" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f0b48c" /><stop offset=".3" stop-color="#c9774a" /><stop offset=".62" stop-color="#8e4a26" /><stop offset="1" stop-color="#c9774a" />
    </linearGradient>
    <linearGradient id="g-iron" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#9aa0a4" /><stop offset=".35" stop-color="#5a6064" /><stop offset=".7" stop-color="#2e3235" /><stop offset="1" stop-color="#6c7276" />
    </linearGradient>
    <linearGradient id="g-verd" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#c3ecdf" /><stop offset=".35" stop-color="#5db5a1" /><stop offset=".72" stop-color="#2b7365" /><stop offset="1" stop-color="#7fc8b6" />
    </linearGradient>
    <radialGradient id="g-face" cx=".5" cy=".42" r=".7">
      <stop offset="0" stop-color="#fcf4da" /><stop offset=".7" stop-color="#eddcae" /><stop offset="1" stop-color="#cdb27a" />
    </radialGradient>
    <linearGradient id="g-glass" x1="0" y1="0" x2=".8" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity=".5" /><stop offset=".42" stop-color="#fff" stop-opacity=".08" /><stop offset=".43" stop-color="#fff" stop-opacity="0" /><stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <linearGradient id="g-airship" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f0cf86" /><stop offset=".45" stop-color="#c0893f" /><stop offset="1" stop-color="#6b4121" />
    </linearGradient>
    <linearGradient id="g-pipe" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#5a2e16" /><stop offset=".3" stop-color="#e09a6b" /><stop offset=".55" stop-color="#b4673a" /><stop offset="1" stop-color="#4b2411" />
    </linearGradient>
    <pattern id="p-hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="5" stroke="#2a1c10" stroke-width=".9" opacity=".55" /></pattern>
  </defs>
</svg>
