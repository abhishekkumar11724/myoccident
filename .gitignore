# Instagram export contains private data (DMs, contacts, login info). NEVER commit or publish it.
# Anchored to the project root on purpose: an unanchored 'assets/' also hid every src/themes/<style>/assets/ folder (fonts, textures, SVGs).
/assets/
node_modules/
dist/
.astro/
.cache/
.DS_Store
.env
.env.local
# generated by `npm run images` (rebuilt from photos/ + each theme's recipe)
public/generated/
src/generated/manifest/*.json
